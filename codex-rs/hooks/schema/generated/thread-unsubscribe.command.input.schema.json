{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "properties": {
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "ThreadUnsubscribe",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions"
      ],
      "type": "string"
    },
    "reason": {
      "enum": [
        "user_requested",
        "thread_switch",
        "programmatic"
      ],
      "type": "string"
    },
    "resume_id": {
      "allOf": [
        {
          "$ref": "#/definitions/NullableString"
        }
      ],
      "description": "The resumable conversation id (the id embedded in the live rollout filename), or null when this thread has no rollout and is therefore not resumable. Consumers building a `codex resume <id>` command MUST use this field — `thread_id`/`session_id` may be a transient side/child/stale thread that `codex resume` cannot find."
    },
    "session_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "transcript_path": {
      "$ref": "#/definitions/NullableString"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "model",
    "permission_mode",
    "reason",
    "resume_id",
    "session_id",
    "thread_id",
    "transcript_path"
  ],
  "title": "thread-unsubscribe.command.input",
  "type": "object"
}